{
    "compilerOptions": {
        "module": "CommonJS",
		"moduleResolution": "Bundler",
       	"target": "ES2024",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"rootDir": "src",
		"outDir": "out",
		"declaration": false,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": true,
		"noImplicitThis": true,
		"preserveSymlinks": true,
		"skipLibCheck": true,
		"tsBuildInfoFile": "out/tsconfig.tsbuildinfo"
    },
    "exclude": [
		"node_modules",
		"packages",
		"tests",
		"out"
	],
	"include": [
		"src"
	],
	"references": [
		{ "path": "./packages/lupos-server" },
	]
}
